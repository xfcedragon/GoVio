# Public Supabase project URL. Accounts turn on only when this and the anon key are both set.
# Leave both unset to keep the local ledger working with no sign-in.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable anon key only. Never put the service-role key in this variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required solely for account deletion. Never expose this to the browser,
# a NEXT_PUBLIC_ variable, an EXPO_PUBLIC_ variable, or the mobile app.
SUPABASE_SERVICE_ROLE_KEY=
