# Public Supabase project URL. Replace both placeholders with the real project values.
# Accounts turn on only when both are set. Clear both to keep the local ledger working with no sign-in.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable anon key only. Never put the service-role key in this variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only. Required solely for account deletion. Add it only in .env.local.
# Never expose it to the browser, a NEXT_PUBLIC_ variable, an EXPO_PUBLIC_ variable, the mobile app, or chat.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
